# Docker 构建上下文排除清单（加速构建、防止敏感信息进入镜像）
# 本地虚拟环境 / 缓存
.venv
venv
__pycache__
**/__pycache__
*.pyc
*.pyo
.pytest_cache
.mypy_cache
.ruff_cache

# 敏感与本地配置（运行时由 compose env_file / environment 注入）
.env
*.env.local

# 运行期数据目录（生产通过挂载卷提供，不进镜像）
chroma_db
uploads
data
*.log

# 测试与文档（不影响运行）
tests
docs
*.md
ui-prototype.html
result.json
test.txt
test_datasets

# 前端 / 版本管理
frontend
frontend_vue
node_modules
.git
.gitignore

# Docker 自身与部署脚本
docker-compose.yml
Dockerfile
.dockerignore
deploy
