# =====================================================================
# 企业垂直知识库 Agent 后台 —— 环境变量样例
# 使用方式：复制本文件为项目根目录下的 .env，并按实际环境修改。
#   cp .env.example .env
# 禁止在代码中硬编码以下任何地址 / 账号 / 密码 / 密钥。
# =====================================================================

# ---------- MySQL 数据库 ----------
# 注意：目标数据库 kb_agent 需先通过 scripts/init_db.sql 创建。
DATABASE_URL=mysql+pymysql://root:your_password@127.0.0.1:3306/kb_agent?charset=utf8mb4

# ---------- Redis ----------
# 无密码时省略 :your_redis_password 部分。
# 末尾的 /N 是 Redis 逻辑库编号：**建议每个项目独占一个库号**（本项目默认 /1），
# 避免与同机其它服务共用 /0 时，任何一方 FLUSHDB 或键名撞车互相影响。
REDIS_URL=redis://:your_redis_password@127.0.0.1:6379/1
# 是否使用内存版 Redis（fakeredis）：true 时不连接外部真实 Redis，便于本地/CI 无 Redis 环境运行。
# 注意：true 会同时导致「会话不跨进程/重启即失效」与「AI 问答限流停用」，仅离线演示可用。
# 生产/联调请保持 false（真实 Redis 下会话存于 Redis，后端重启不会踢人下线）。
FAKE_REDIS=false
# 每用户每分钟 AI 问答上限（/conversations/*/chat、/chat/stream、/kbs/{id}/query 共用）；
# 也可在系统配置页热更新，未配置时默认 30。
AI_RATE_LIMIT_PER_MINUTE=30

# ---------- 密钥 ----------
# 用于签名 session/refresh token 的随机长字符串。
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=please_change_me_to_a_long_random_secret

# ---------- 会话有效期（秒） ----------
# SESSION_TTL / REFRESH_TTL 是「多久不用就过期」（每次使用会滑动续期）；
# TOKEN_MAX_LIFETIME 是「无论多活跃，一次登录最长能活多久」（绝对，续期不重置）。
# 两者缺一不可：只有滑动续期时，持续访问即可永久驻留，等于没有会话上限。
SESSION_TTL_SECONDS=7200
REFRESH_TTL_SECONDS=604800
# 默认 30 天；最小按 1 小时兜底。到期后 access 与 refresh 同时失效，必须重新登录。
TOKEN_MAX_LIFETIME_SECONDS=2592000

# ---------- 其他 ----------
# 启动时是否自动建表（true/false）。默认 false，推荐先执行 scripts/init_db.sql 建表。
AUTO_CREATE_TABLES=true
# 启动期 ORM / 数据库结构一致性自检（v1.7）：
#   strict（默认）= 发现 ORM 有、库里没有的列/表时打 ERROR 日志并中止启动（并给出可执行的 ALTER）
#   warn          = 只打 ERROR 日志，服务继续启动（适合"先起服务、再补库"）
#   off           = 关闭检查
# 说明：create_all 只建缺失的表、不会给存量表补列，所以 ORM 新增字段必须靠自检提前暴露，
#       否则会在读写该字段的接口上表现为 500。数据库连不上时不算漂移，只警告并跳过。
SCHEMA_CHECK_MODE=strict
# 允许跨域来源，逗号分隔；开发环境可用 *，生产请配置具体域名。
CORS_ORIGINS=*
LOG_LEVEL=INFO
APP_NAME=企业垂直知识库 Agent 后台

# ---------- 初始化管理员密码（scripts/seed.py 使用，也可用 --password 传参） ----------
# 若都不提供，seed.py 会生成随机密码并打印到终端。
# ADMIN_INIT_PASSWORD=

# ---------- RAG / 向量库 / LLM ----------
# 上传文件存储目录与 Chroma 向量库持久化目录（相对项目根目录）
UPLOAD_DIR=uploads
CHROMA_PERSIST_DIR=chroma_db

# Embedding 提供方：hash=本地特征哈希(免密钥，测试用) / openai=OpenAI 兼容接口
EMBEDDING_PROVIDER=hash
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIM=384

# LLM 提供方：mock=回显检索结果(免密钥，测试用) / openai=OpenAI 兼容 / anthropic=Claude
LLM_PROVIDER=mock
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=

# 单次回答最大输出 token（默认 2048）：成本封顶 + 让截断可控。
# 命中上限时上游仍返回 HTTP 200（finish_reason=length），系统会自动在回答末尾
# 追加「已达到最大长度限制」提示，并在 trace_logs.is_truncated 标记，便于统计截断率。
LLM_MAX_TOKENS=2048

# 送入 LLM 上下文的历史窗口：只保留最近 N 轮（1 轮 = 1 问 + 1 答）
CHAT_HISTORY_MAX_TURNS=5
# 历史字符总预算：超过则从最早的消息开始丢弃（防止用户粘贴长文档把 prompt 撑爆）
CHAT_HISTORY_MAX_CHARS=2000
