# ============================================================================
# AgentFlow Platform — W1 环境变量示例
# 用法：cp .env.example .env 后按需修改（.env 不入库）
# ============================================================================

# ---------- 应用基础 ----------
APP_NAME=AgentFlow Platform
# local / test / staging / prod
APP_ENV=local
DEBUG=true
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
# true：结构化 JSON 日志（含 trace_id）；本地调试可置 false 走可读格式
LOG_JSON=true
# 前端联调用，逗号分隔；W1 前端尚未实现，仅预留
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- MySQL ----------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=agentflow
MYSQL_PASSWORD=agentflow_pwd
MYSQL_DB=agentflow
MYSQL_POOL_SIZE=10
MYSQL_MAX_OVERFLOW=20
MYSQL_POOL_RECYCLE=1800
# 打印 SQL（仅本地排查用）
MYSQL_ECHO=false

# ---------- Redis ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=50
# 所有 key 统一前缀，避免与项目一 / 项目二共用实例时冲突
REDIS_KEY_PREFIX=agentflow

# ---------- 鉴权（双 Token + Redis 黑名单）----------
# 生产必须替换：openssl rand -hex 32
SECRET_KEY=dev-only-secret-change-me-0123456789abcdef
JWT_ALGORITHM=HS256
JWT_ISSUER=agentflow-platform
# access 2h / refresh 7d（PRD NFR-S4）
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7
# bcrypt cost（测试环境可降到 4 提速）
BCRYPT_ROUNDS=12
# 单用户最大会话数（refresh 轮换时超限淘汰最旧会话，0=不限制）
AUTH_MAX_SESSIONS_PER_USER=5

# ---------- LLM（W1 仅配置预留，未发起任何调用）----------
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
# 备用模型（SiliconFlow Qwen2.5-72B，PRD A-04）
LLM_FALLBACK_MODEL=Qwen/Qwen2.5-72B-Instruct
LLM_TEMPERATURE=0.2
# 限制单次大模型最大输出 Token 数，防 Output 爆炸（任务 9；代码默认 2048，建议不高于 4096）
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRY=2

# ---------- 外部依赖 Mock 开关 ----------
# true：不访问项目一 RAG 接口，返回结构化 Mock 结果（W1 默认 true）
MOCK_EXTERNAL_RAG=true
# true：不访问项目二 EvalAgent 接口，Reviewer 走本地规则降级（W1 默认 true）
MOCK_EXTERNAL_EVAL=true
EXTERNAL_RAG_BASE_URL=http://localhost:8000
EXTERNAL_RAG_TOKEN=
EXTERNAL_RAG_TIMEOUT_SECONDS=8
EXTERNAL_EVAL_BASE_URL=http://localhost:8100
EXTERNAL_EVAL_TIMEOUT_SECONDS=10

# ---------- LangGraph（W1 仅导入预留，不构建业务 graph）----------
# checkpointer 快照 TTL：72h（PRD 5.2）
LANGGRAPH_CHECKPOINT_TTL_SECONDS=259200

# ============================================================================
# W2 追加：编排内核 / MCP 工具层 / 上下文工程
# 说明：以下变量由 app/core/w2_config.py 读取（字段名即变量名，大小写敏感）
# ============================================================================

# ---------- LLM ----------
# true：使用确定性 Mock 客户端，无 API Key 也能跑通全链路（本地自测 / CI 默认）
LLM_MOCK=true
# 主模型：DeepSeek-V3（OpenAI 兼容）
LLM_API_KEY=
LLM_MODEL=deepseek-chat
# 降级模型：SiliconFlow Qwen2.5-72B（主模型失败时重试 1 次）
LLM_FALLBACK_BASE_URL=https://api.siliconflow.cn/v1
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=Qwen/Qwen2.5-72B-Instruct
LLM_FALLBACK_ENABLED=true
# 结构化输出修复重试次数（PRD FR-002 验收 2：最多 2 次）
STRUCTURED_REPAIR_MAX_RETRY=2

# ---------- 节点 Token 预算（PRD 9.1，32K 窗口）----------
TOKEN_BUDGET_PLANNER=6000
TOKEN_BUDGET_EXECUTOR=8000
TOKEN_BUDGET_REVIEWER=4000
TOKEN_BUDGET_SUMMARIZER=5000
# 上下文压缩（PRD 9.2）
COMPRESS_ENABLED=true
COMPRESS_TRIGGER_RATIO=0.8
COMPRESS_MESSAGE_ROUNDS_THRESHOLD=12
COMPRESS_KEEP_RECENT_ROUNDS=3
COMPRESS_MAX_LAYERS=2

# ---------- Agent 行为上限 ----------
PLAN_MIN_SUBTASKS=3
PLAN_MAX_SUBTASKS=15
REPLAN_MAX_COUNT=2
TOOL_LOOP_LIMIT=8
# 测试可置 false 关闭退避等待
TOOL_RETRY_BACKOFF_ENABLED=true
MCP_CALL_TIMEOUT_SECONDS=30

# ---------- sql-query MCP Server（只读）----------
SQL_ALLOWED_TABLES=orders,traffic_records,ad_campaigns,skus,categories
SQL_MAX_ROWS=1000
SQL_DEFAULT_LIMIT=1000
SQL_EXEC_TIMEOUT_SECONDS=10
SQL_MAX_SCAN_ROWS=1000000
# 只读账号（仅 SELECT on mall），与业务库写账号分离
SQL_RO_HOST=127.0.0.1
SQL_RO_PORT=3306
SQL_RO_USER=mall_ro
SQL_RO_PASSWORD=mall_ro_pwd
SQL_RO_DB=mall

# ---------- chart-render MCP Server ----------
CHART_MAX_ROWS=500
CHART_RENDER_TIMEOUT_SECONDS=15
CHART_USE_PROCESS_POOL=true
CHART_POOL_SIZE=2
CHART_OUTPUT_DIR=storage/charts
CHART_STATIC_URL_PREFIX=/static/charts

# ---------- kb-search MCP Server ----------
# MOCK_EXTERNAL_RAG=true 时走内置周报样本，不访问项目一
KB_MAX_QUERY_LEN=200
KB_DEFAULT_TOP_K=3
KB_MAX_TOP_K=5
KB_TIMEOUT_SECONDS=20
KB_RETRY_TIMES=2
KB_MAX_CALLS_PER_TASK=10
KB_TENANT=agentflow

# ---------- notify MCP Server（恒 Mock，不出网）----------
NOTIFY_TIMEOUT_SECONDS=5
NOTIFY_MAX_RECEIVERS=10
NOTIFY_MAX_CONTENT_LEN=2000
NOTIFY_DRY_RUN=true

# ---------- Reviewer ----------
REVIEW_PASS_THRESHOLD=3.5
REVIEW_SKIP_AFTER_FAILURES=2
REVIEW_LOCAL_WEIGHT=0.6

# ---------- 通用 ----------
STORAGE_DIR=storage
# 项目二回调 sync 模式超时（W4 使用）
API_SYNC_TIMEOUT_SECONDS=300
# checkpointer：auto=优先 RedisSaver，连不上降级内存；redis=强制；memory=纯内存（测试）
CHECKPOINTER_BACKEND=auto

# ============================================================================
# W3 段：SSE 进度流 / Redis Stream 事件总线 / 审批收件箱 / 轨迹回放 / 断点续跑
# 说明：以下变量由 app/core/w3_config.py 的 W3Settings 读取，缺失时全部走代码默认值
# ============================================================================

# ---------- SSE 进度流（FR-009）----------
# SSE 总开关；false 时 GET /tasks/{id}/stream 直接返回 503 STREAM_DISABLED
SSE_ENABLED=true
# 期望的事件协议版本，默认 v3（若运行时不支持会自动降级到 v2/v1，无需改此值）
SSE_EVENTS_VERSION=v3
# Redis XREAD 阻塞毫秒数；0 表示非阻塞轮询（单测用 0，避免连接空转）
SSE_BLOCK_MS=5000
# 非阻塞模式下的轮询间隔（毫秒），仅 SSE_BLOCK_MS=0 时生效
SSE_POLL_INTERVAL_MS=200
# 单次 XREAD 最多拉取的事件条数
SSE_READ_COUNT=100
# 下发给浏览器的重连建议间隔（SSE retry: 字段，毫秒）
SSE_RETRY_MS=3000
# 连接空闲超过该秒数（且任务未到终态）主动收尾，避免长连接泄漏
SSE_IDLE_TIMEOUT_SECONDS=900
# 单条 SSE 连接最长存活秒数（兜底，到点发 complete 并关闭）
SSE_MAX_DURATION_SECONDS=3600
# 心跳注释帧（": ping"）建议间隔秒数，供前端与 Nginx 超时配置参考
SSE_HEARTBEAT_SECONDS=15

# ---------- Redis Stream 事件总线 ----------
# Stream key 前缀，实际 key 形如 events:{task_id}
STREAM_KEY_PREFIX=events
# 单任务 Stream 近似长度上限（XADD MAXLEN ~ N），防内存无界增长
STREAM_MAXLEN=10000
# Stream 保留时长（秒），与 PRD「事件可回放 24h」对齐
STREAM_TTL_SECONDS=86400
# auto=优先 Redis、失败自动降级进程内内存；redis=强制 Redis（失败即报错）；memory=纯内存（测试/无 Redis 演示）
STREAM_BACKEND=auto

# ---------- 轨迹回放（FR-015）----------
# 轨迹采集总开关；false 时 GET /tasks/{id}/trace 返回 503 TRACE_DISABLED
TRACE_ENABLED=true
# 单条 trace payload 序列化后的最大字符数，超出转 preview 形态（防 JSON 列膨胀）
TRACE_PAYLOAD_MAX_CHARS=4000
# 回放接口单次最多返回的 span（节点/工具/LLM 调用）条数
TRACE_REPLAY_MAX_STEPS=500
# 回放接口最多返回的 checkpoint 快照数（aget_state_history 截断上限）
TRACE_REPLAY_MAX_SNAPSHOTS=100

# ---------- 审批（FR-011）----------
# 待审批收件箱单页最大条数（超出自动收敛到该值）
APPROVAL_INBOX_MAX_PAGE_SIZE=100
# 是否允许「提交人=审批人」自审自批；MVP 演示放开为 true，生产建议 false
APPROVAL_ALLOW_SELF_DECIDE=true
# 取消标记在 Redis 中的存活秒数（任务取消后标记仍保留，防延迟节点回写）
CANCEL_FLAG_TTL_SECONDS=86400

# ---------- 断点续跑 ----------
# POST /tasks/{id}/resume 默认是否同步等待到「下一次挂起或终态」再返回；false 表示立即返回受理
RESUME_SYNC_DEFAULT=false
# GET /tasks/{id}/snapshot 返回的最近消息条数（0 表示不返回消息，只返回状态骨架）
SNAPSHOT_RECENT_MESSAGES=5

# ===================== W5-Part1：MCP HTTP 传输 =====================
# 双传输并存：false 时仅 stdio（默认）；true 时额外挂载 /mcp/v1
MCP_HTTP_ENABLED=false
MCP_HTTP_LISTEN_HOST=127.0.0.1
MCP_HTTP_LISTEN_PORT=9100
# 生产必须配置；为空则跳过鉴权（启动日志会告警）
MCP_HTTP_API_KEY=
# 客户端连接目标（可指向远端 MCP-HTTP 服务）
MCP_HTTP_BASE_URL=http://127.0.0.1:9100
MCP_HTTP_PATH=/mcp/v1
MCP_HTTP_TIMEOUT_SECONDS=15
MCP_HTTP_CONNECT_TIMEOUT_SECONDS=3
MCP_HTTP_MAX_CONNECTIONS=20
MCP_HTTP_RETRY_TIMES=1
MCP_HTTP_BREAKER_THRESHOLD=3
MCP_HTTP_BREAKER_RECOVERY_SECONDS=30
MCP_HTTP_SSE_MAX_SECONDS=300
MCP_HTTP_SESSION_TTL_SECONDS=600

# ===================== W5-Part1：FR-014 分层记忆 =====================
# 全局总开关：false 时完全不检索/不注入/不落库（W1~W4 行为零影响）
ENABLE_LAYERED_MEMORY=false
MEMORY_SHORT_TTL_SECONDS=86400
MEMORY_MID_TTL_DAYS=30
MEMORY_LONG_MIN_REVIEW_SCORE=3
MEMORY_LONG_TOP_K=3
MEMORY_RECALL_MIN_SCORE=0.15
MEMORY_INJECT_MAX_CHARS=400
MEMORY_LOCAL_RECALL_ENABLED=true

# ---- 记忆语义向量（2026-10-27 起：真语义召回，不再依赖项目一 /kb/upsert|search）----
# local-embedding=本地 embedding+余弦（默认）；http-rag=项目一接口（当前 404）；keyword=本地关键词
MEMORY_VECTOR_BACKEND=local-embedding
MEMORY_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 复用平台已有百炼 key（与项目二评测裁判同源，chat/embeddings 同 key）
MEMORY_EMBEDDING_API_KEY=sk-ws-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MEMORY_EMBEDDING_MODEL=text-embedding-v3
MEMORY_EMBEDDING_DIMS=1024
MEMORY_EMBEDDING_BATCH_SIZE=6
MEMORY_EMBEDDING_TIMEOUT_SECONDS=15
# 向量余弦阈值：无关文本基线约 0.3~0.4，不能用关键词的 0.15
MEMORY_RECALL_MIN_SCORE_VECTOR=0.55

# ===================== W5-Part2：SSE 分布式会话 =====================
# memory = 单进程（默认，本地/CI 零依赖）；redis = 多副本共享（生产必开）
SESSION_REGISTRY_BACKEND=memory
SESSION_REGISTRY_KEY_PREFIX=mcp:sess
SESSION_REGISTRY_INDEX_KEY=mcp:sess:index
SESSION_REGISTRY_QUEUE_MAX=256
SESSION_REGISTRY_POLL_INTERVAL_SECONDS=0.05
SESSION_REGISTRY_SYNC_TIMEOUT_SECONDS=0.05
# Redis 故障时是否退回进程内会话表（true=不阻断服务）
SESSION_REGISTRY_DEGRADE_TO_MEMORY=true
SESSION_REGISTRY_PING_ON_START=true

# ===================== W5-Part2：OpenTelemetry 埋点 =====================
# false = 不初始化 provider、不打任何 patch，运行时零开销
ENABLE_OTEL=false
OTEL_SERVICE_NAME=agentflow-platform
OTEL_SERVICE_VERSION=0.5.2-w5p2
OTEL_DEPLOYMENT_ENV=local
# otlp = OTLP/HTTP；console = 打印到控制台；none = 只留埋点不导出
OTEL_EXPORTER=otlp
# 采集器不可达时自动降级为 console（任务书要求）
OTEL_AUTO_FALLBACK_CONSOLE=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_EXPORTER_OTLP_TRACES_PATH=/v1/traces
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_EXPORTER_TIMEOUT_SECONDS=3
OTEL_SAMPLE_RATIO=1.0
OTEL_BATCH_MAX_QUEUE=2048
OTEL_BATCH_MAX_EXPORT=512
OTEL_BATCH_SCHEDULE_DELAY_MS=2000
OTEL_EXCLUDE_PATHS=/health,/ready,/healthz,/readyz,/metrics,/docs,/redoc,/openapi.json,/favicon.ico
OTEL_CAPTURE_SQL_PARAMS=false
OTEL_MAX_ATTR_LENGTH=512
OTEL_TRACE_HTTP=true
OTEL_TRACE_GRAPH=true
OTEL_TRACE_MCP=true
OTEL_TRACE_LLM=true
OTEL_TRACE_SQL=true
OTEL_METRICS_PREFIX=agentflow

# ===================== W5-Part2：SSE 边界加固 =====================
# false 时完全走 W3 原事件流（行为逐字节不变）
SSE_GUARD_ENABLED=false
SSE_HEARTBEAT_SECONDS=15
SSE_IDLE_TIMEOUT_SECONDS=20
SSE_CONNECTION_MAX_SECONDS=900
SSE_RETRY_INTERVAL_MS=3000
TASK_CANCEL_CLEANUP_ENABLED=true
TASK_CONSISTENCY_MAX_STEP_LAG=1

# ===================== P2 收尾：RAG 检索字段对齐 =====================
# mock=true 时 RagContractClient 直接返回预置片段，零网络请求（CI/本地默认）
# 复用 W1 既有 MOCK_EXTERNAL_RAG 开关（见本文件第 66 行），此处仅补充契约相关项
# 严格模式：上游少字段直接报错（联调期打开，生产保持 false 走尽力归一化）
RAG_CONTRACT_STRICT=false

# ===================== P2 收尾：长期记忆去重 / 衰减 / TTL =====================
# 总开关：false 时四个方法（archive_long/recall/purge_expired/create_memory）保持原实现
ENABLE_MEMORY_LIFECYCLE=false
MEMORY_DEDUP_ENABLED=true
# 相似度阈值：0.88 ≈「同一结论换个说法」；接真实 embedding 后可上调至 0.95
MEMORY_DEDUP_THRESHOLD=0.88
MEMORY_DEDUP_CANDIDATES=50
MEMORY_DECAY_ENABLED=true
# w = exp(-λ·Δt)，λ=0.01 对应半衰期 ≈ 69 天
MEMORY_DECAY_LAMBDA=0.01
MEMORY_DECAY_MIN_WEIGHT=0.05
MEMORY_DECAY_IMPORTANCE_BOOST=0.06
# true = 衰减后再按 min_score 二次过滤（默认只影响排序，不减少条数）
MEMORY_DECAY_REFILTER=false
# 长期记忆 TTL（天），0 = 永久不过期
MEMORY_LONG_TTL_DAYS=180
MEMORY_TTL_CLEANUP_ENABLED=true
MEMORY_EMBED_DIM=128

# ===================== v1.1：项目一知识库真实检索 =====================
# 真实检索入口是 POST /api/v1/kbs/{kb_id}/query（PRD A-01 假设的 /api/v1/kb/search 在项目一不存在）
EXTERNAL_RAG_CONTRACT=project1_kb_query
EXTERNAL_RAG_KB_ID=6
EXTERNAL_RAG_USERNAME=
EXTERNAL_RAG_PASSWORD=
EXTERNAL_RAG_TOKEN_TTL_SECONDS=1500
# 评审判定：拒绝线 / 可信度下限 / REJECT 人工批注闸门
REVIEW_REJECT_THRESHOLD=2.5
REVIEW_CONFIDENCE_FLOOR=0.55
REVIEW_HUMAN_INTERVENTION_ENABLED=true

# ===================== v1.2：全局限流 =====================
# 固定窗口计数（Redis INCR+EXPIRE），按用户 / 任务双维度；测试环境 APP_ENV=test 下自动不生效
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_API_PER_MINUTE=300
RATE_LIMIT_LLM_PER_MINUTE=30
RATE_LIMIT_KB_PER_MINUTE=60
RATE_LIMIT_TASK_PER_MINUTE=240
RATE_LIMIT_EXEMPT_PATHS=/health,/healthz,/readyz,/metrics,/docs,/redoc,/openapi.json,/static,/favicon.ico
RATE_LIMIT_PER_IP_ENABLED=true
RATE_LIMIT_EXPOSE_HEADERS=true
RATE_LIMIT_KEY_PREFIX=rl
