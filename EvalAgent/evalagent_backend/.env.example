# 复制为 .env 后按本机情况修改
APP_HOST=127.0.0.1
APP_PORT=8200
DEBUG=true

DATABASE_URL=mysql+pymysql://root:你的密码@127.0.0.1:3306/eval_agent_db?charset=utf8mb4
SQL_ECHO=false
AUTO_CREATE_TABLES=true

UPSTREAM_RAG_BASE_URL=http://127.0.0.1:8000
UPSTREAM_RAG_TIMEOUT=60
UPSTREAM_RAG_CONCURRENCY=4
UPSTREAM_RAG_TOKEN=

JUDGE_PROVIDER=dashscope
JUDGE_MODEL=
JUDGE_API_KEY=
JUDGE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
JUDGE_MAX_CONCURRENCY=3

# ---------- 鉴权（写入类接口需要 admin）----------
# 身份归项目一：拿 token 调 GET /auth/me 换 role 判 admin，本服务不自建用户表
AUTH_ENFORCE=true
AUTH_UPSTREAM_BASE_URL=
AUTH_CACHE_TTL=60
