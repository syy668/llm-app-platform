# ---------------------------------------------------------------------------
# 后端服务地址（一个文件覆盖全部后端配置）
# ---------------------------------------------------------------------------
# 生产/联调：后端根地址（不含 /api/v1），axios 会自行拼接 API_PREFIX
VITE_API_BASE_URL=http://127.0.0.1:8000

# API 版本前缀，与后端 settings.API_V1_PREFIX 保持一致
VITE_API_PREFIX=/api/v1

# 开发期 Vite dev-server 代理目标（仅在 npm run dev 时生效）
VITE_PROXY_TARGET=http://127.0.0.1:8000

# 请求超时（毫秒）。注意：SSE 不受此限制，走原生 EventSource
VITE_REQUEST_TIMEOUT=20000

# 应用标题（登录页与侧边栏品牌位展示）
VITE_APP_TITLE=AgentFlow

# 版本号（侧边栏底部展示，与后端 /healthz 的 version 对齐）
VITE_APP_VERSION=1.0.0
